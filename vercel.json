{
    "buildCommand": "vite build",
    "outputDirectory": "dist",
    "devCommand": "vite --port=5000 --host=0.0.0.0",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/server"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/server.js": {
            "memory": 512,
            "maxDuration": 60
        }
    }
}