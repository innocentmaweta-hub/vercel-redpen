{
    "buildCommand": "vite build",
    "outputDirectory": "dist",
    "devCommand": "vite --port=5000 --host=0.0.0.0",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://empire16.com"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
